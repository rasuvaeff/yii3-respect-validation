{
    "name": "rasuvaeff/yii3-respect-validation",
    "description": "Bridge exposing Respect/Validation rules as native yiisoft/validator rules for Yii3 applications",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "yii3",
        "validator",
        "validation",
        "respect",
        "respect-validation"
    ],
    "authors": [
        {
            "name": "Victor Razuvaev",
            "email": "rasuvaeff@gmail.com"
        }
    ],
    "homepage": "https://github.com/rasuvaeff/yii3-respect-validation",
    "support": {
        "issues": "https://github.com/rasuvaeff/yii3-respect-validation/issues",
        "source": "https://github.com/rasuvaeff/yii3-respect-validation"
    },
    "require": {
        "php": ">=8.5",
        "respect/validation": "^3.1",
        "yiisoft/translator": "^3.0",
        "yiisoft/validator": "^2.6"
    },
    "require-dev": {
        "amphp/amp": "^3.1.2",
        "amphp/byte-stream": "^2.1.2",
        "amphp/cache": "^2.0.1",
        "amphp/dns": "^2.4",
        "amphp/parallel": "^2.4",
        "amphp/parser": "^1.1.1",
        "amphp/pipeline": "^1.2.5",
        "amphp/process": "^2.1",
        "amphp/serialization": "^1.1",
        "amphp/socket": "^2.4",
        "amphp/sync": "^2.3",
        "danog/advanced-json-rpc": "^3.2.3",
        "daverandom/libdns": "^2.1",
        "ergebnis/composer-normalize": "^2.51",
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.33",
        "maglnet/composer-require-checker": "^4.17",
        "netresearch/jsonmapper": "^5.0.1",
        "rasuvaeff/property-testing": "^2.8",
        "rector/rector": "^2.4",
        "revolt/event-loop": "^1.0.9",
        "roave/backward-compatibility-check": "^8.0",
        "spatie/array-to-xml": "^3.4",
        "testo/bridge-infection": "^0.1.6",
        "testo/testo": "^0.10.25",
        "vimeo/psalm": "^6.16",
        "yiisoft/translator-message-php": "^1.1"
    },
    "suggest": {
        "yiisoft/translator-message-php": "Enables the bundled messages/{locale} translation catalogs (ru) via MessageSource"
    },
    "autoload": {
        "psr-4": {
            "Rasuvaeff\\Yii3RespectValidation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rasuvaeff\\Yii3RespectValidation\\Benchmarks\\": "benchmarks/",
            "Rasuvaeff\\Yii3RespectValidation\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true
        },
        "platform": {
            "ext-bcmath": "1.0.0",
            "ext-intl": "1.0.0"
        },
        "sort-packages": true
    },
    "extra": {
        "config-plugin": {
            "di": "di.php",
            "params": "params.php"
        },
        "config-plugin-options": {
            "source-directory": "config"
        }
    },
    "scripts": {
        "bc-check": "roave-backward-compatibility-check",
        "bench": "testo --suite=Benchmarks -vv",
        "build": [
            "@composer validate --strict",
            "@composer normalize --dry-run",
            "@require-checker",
            "@cs",
            "@psalm",
            "@test"
        ],
        "cs": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.php",
        "cs:fix": "php-cs-fixer fix --diff --config=.php-cs-fixer.php",
        "mutation": "infection --threads=max",
        "psalm": "psalm --no-cache",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "release-check": [
            "@build",
            "@rector",
            "@bc-check"
        ],
        "require-checker": "composer-require-checker check composer.json",
        "test": "testo --suite=Unit",
        "test:coverage": "testo --suite=Unit --coverage --coverage-clover=build/coverage.xml",
        "test:coverage:ci": "testo --suite=Unit --coverage-clover=build/coverage.xml"
    }
}
